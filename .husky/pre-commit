#!/usr/bin/env sh
set -eu

cd "$(git rev-parse --show-toplevel)"

# Single list of extensions: cheap skip-check and lint-staged glob.
set -- js ts svelte css md json
grep_pat=
glob_inner=
for ext do
  grep_pat="${grep_pat:+$grep_pat|}$ext"
  glob_inner="${glob_inner:+$glob_inner,}$ext"
done

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE "\.(${grep_pat})$"; then
  exit 0
fi

lint_staged="frontend/viewer/node_modules/.bin/lint-staged"
if [ ! -f "$lint_staged" ]; then
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "pre-commit: staged *.{${glob_inner}} files need prettier, but frontend/viewer/node_modules is missing and pnpm is not installed." >&2
    echo "pre-commit: install pnpm, then run: cd frontend && pnpm install" >&2
    exit 1
  fi
  echo "pre-commit: frontend deps missing, installing (one-time per worktree, ~45s)..." >&2
  # --frozen-lockfile so committing can never rewrite pnpm-lock.yaml
  (cd frontend && pnpm install --frozen-lockfile) >&2
fi

printf '{"*.{%s}":"prettier --write"}\n' "$glob_inner" |
  "$lint_staged" --config - --cwd frontend/viewer
