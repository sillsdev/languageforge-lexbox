<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!--        override the target framework set in Directory.Build.props, we will use what is defined in TargetFrameworks below instead-->
    <TargetFramework />
    <TargetFrameworks Condition=" '$(BuildAndroid)' != 'false' ">$(TargetFrameworks);net11.0-android;</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) And '$(BuildApple)' != 'false'">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
    <!-- Skipped under Dependabot (DEPENDABOT_JOB_ID is set in its updater): its container has no Android workload, so
         android-arm resolves to Microsoft.NETCore.App.Runtime.linux-bionic-* packs that don't exist on nuget.org
         and the whole NuGet update job aborts with dependency_not_found. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DEPENDABOT_JOB_ID)' == ''">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Universal (Intel + Apple Silicon) Release build. Set here (on the app project) rather than via a
         global -p:RuntimeIdentifiers on the command line, which would leak the multi-RID value into every
         referenced library and fail them with NETSDK1083. Skipped when a single RuntimeIdentifier is
         passed explicitly (e.g. the CI unsigned fork build's maccatalyst-arm64 compile check). -->
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(RuntimeIdentifier)' == ''">maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
    <!-- Otherwise SelfContained makes the SDK put the host RID in the universal build's output path (bin/.../osx-arm64/). -->
    <UseCurrentRuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">false</UseCurrentRuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <RootNamespace>FwLiteMaui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <CompressionEnabled>false</CompressionEnabled>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting Condition="$([MSBuild]::IsOSPlatform('linux'))">true</EnableWindowsTargeting>
    <IncludeFwDataBridge>false</IncludeFwDataBridge>
    <IncludeFwDataBridge Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</IncludeFwDataBridge>
    <DefineConstants Condition="$(IncludeFwDataBridge)">$(DefineConstants);INCLUDE_FWDATA_BRIDGE</DefineConstants>
    <!-- controls display name in Package.appxmanifest -->
    <ApplicationTitle>FieldWorks Lite</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>org.sil.FwLiteMaui</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
  </PropertyGroup>
  <!-- Side-by-side "Dev" flavor: set -p:FwLiteFlavor=Dev to install alongside the prod app
       (different package name + label so both can coexist on a device). -->
  <PropertyGroup Condition="'$(FwLiteFlavor)' == 'Dev'">
    <ApplicationId>org.sil.FwLiteMaui.dev</ApplicationId>
    <ApplicationTitle>FieldWorks Lite Dev</ApplicationTitle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' ">
    <WindowsPackageType>None</WindowsPackageType>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!--        single file disabled as it's less efficient for updates-->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And $(WindowsPackageType) == 'None'">
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup>
    <TargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</TargetPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetPlatform)' == 'ios' Or '$(TargetPlatform)' == 'maccatalyst'">
    <!-- The .NET for iOS SDK refuses to build unless the installed Xcode matches its expected minor version exactly.
         We build with whatever Xcode is installed (newer works); drop this once the workload catches up. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- iOS has no JIT. EF Core 10 refuses to build its model / compile queries when dynamic code is unsupported,
         so the Mono interpreter is mandatory. Enabled in Debug too so both builds exercise the same runtime. -->
    <UseInterpreter>true</UseInterpreter>
    <!-- Route every HttpClient through Apple's NSUrlSessionHandler (Network.framework) instead of the managed
         SocketsHttpHandler + SslStream. The managed TLS path on Apple is the deprecated SecureTransport shim, which
         resets the handshake against modern TLS-1.3 servers (e.g. lexbox.org's OIDC endpoint) — login fails with
         "net_http_ssl_connection_failed / Connection reset by peer", only on Mac/iOS. Native handler negotiates fine. -->
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetPlatform)' == 'ios'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetPlatform)' == 'ios' And $(RuntimeIdentifier.StartsWith('iossimulator'))">
    <!-- Simulator builds are unsigned by default, which drops the entitlements above (MSAL keychain access fails).
         Ad-hoc sign so the entitlements apply; device builds need a real identity anyway. -->
    <EnableCodeSigning>true</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>
    <CodesignEntitlements>Platforms\iOS\Entitlements.Simulator.plist</CodesignEntitlements>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And ('$(TargetPlatform)' == 'ios' Or '$(TargetPlatform)' == 'maccatalyst')">
    <!-- With the interpreter on, the SDK defaults the simulator to no linking; force the device default so trimming
         failures show up in the simulator. Do not set PublishTrimmed/TrimMode: the iOS SDK owns those. -->
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetPlatform)' == 'ios' Or '$(TargetPlatform)' == 'maccatalyst'">
    <!-- SIL.Core's Platform.MonoVersion P/Invokes mono_get_runtime_build_info from "__Internal", and the iOS SDK turns
         every __Internal P/Invoke into a required native symbol. .NET 11 runs iOS on CoreCLR, which doesn't export it,
         so the link fails. SIL.Core only calls it when running on Mono, so don't require the symbol. -->
    <ReferenceNativeSymbol Include="mono_get_runtime_build_info" SymbolType="Function" SymbolMode="Ignore" />
  </ItemGroup>
  <PropertyGroup>
    <FwLiteLogos>$(MSBuildThisFileDirectory)..\..\..\logos\fieldworks-lite\</FwLiteLogos>
  </PropertyGroup>
  <ItemGroup>
    <!-- App Icon, drawn from the shipped set in logos/fieldworks-lite (see its README for which file goes where).
         Link names the generated icon "appicon", which AndroidManifest.xml and the Info.plist XSAppIconAssets refer to. -->
    <MauiIcon Condition="'$(TargetPlatform)' == 'ios'" Include="$(FwLiteLogos)fieldworks-lite-appicon-square.svg" Link="appicon.svg" />
    <MauiIcon Condition="'$(TargetPlatform)' == 'maccatalyst'" Include="$(FwLiteLogos)fieldworks-lite-appicon-macos.svg" Link="appicon.svg" />
    <!-- The logo guide (index.html) sizes the book at 75% of the visible 72dp icon: 0.75 * 72/108.
         Resizetizer doesn't notice a ForegroundScale change: clean obj before checking a new value. -->
    <MauiIcon Condition="'$(TargetPlatform)' == 'android'" Include="$(FwLiteLogos)fieldworks-lite-circle.svg" Link="appicon.svg" Color="#ffffff" ForegroundScale="0.5" />
    <!-- Reversed because the .ico (portable app, window) has one drawing for both themes, and the light one nearly vanishes on a dark taskbar.
         The MSIX taskbar icons are swapped per theme and size by FwLiteMsixTaskbarIcons below. -->
    <MauiIcon Condition="'$(TargetPlatform)' != 'ios' And '$(TargetPlatform)' != 'maccatalyst' And '$(TargetPlatform)' != 'android'" Include="$(FwLiteLogos)fieldworks-lite-small-reversed.svg" Link="appicon.svg" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\AppIcon\splash.svg" Color="#1f2a44" BaseSize="288,288" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- MauiIcon gives every Windows taskbar icon the same drawing. MSIX can do better: it picks a file per size and per
       taskbar theme (altform-unplated on dark, altform-lightunplated on light), so give it the logo's drawing for each. -->
  <Target Name="FwLiteMsixTaskbarIcons" AfterTargets="ResizetizeImages" Condition="'$(TargetPlatform)' == 'windows'">
    <ItemGroup>
      <_FwLiteTaskbarSize Include="16;24;32;48;256" />
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)"
                             Condition="$([System.String]::Copy('%(TargetPath)').StartsWith('appiconLogo.')) And $([System.String]::Copy('%(TargetPath)').Contains('targetsize-'))" />
      <ContentWithTargetPath Include="@(_FwLiteTaskbarSize->'$(FwLiteLogos)png\fieldworks-lite-reversed-%(Identity).png')"
                             TargetPath="appiconLogo.targetsize-%(_FwLiteTaskbarSize.Identity).png" CopyToPublishDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="@(_FwLiteTaskbarSize->'$(FwLiteLogos)png\fieldworks-lite-reversed-%(Identity).png')"
                             TargetPath="appiconLogo.altform-unplated_targetsize-%(_FwLiteTaskbarSize.Identity).png" CopyToPublishDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="@(_FwLiteTaskbarSize->'$(FwLiteLogos)png\fieldworks-lite-%(Identity).png')"
                             TargetPath="appiconLogo.altform-lightunplated_targetsize-%(_FwLiteTaskbarSize.Identity).png" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="NReco.Logging.File" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Windows-only toast notifications (used by Platforms/Windows/AppUpdateService.cs). Conditioned
         so it is not pulled into the iOS/Mac/Android bundles, where it is unused dead weight. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- ICU natives + data for icu.net collation (Android has no public system ICU). -->
    <PackageReference Include="Icu4c.Android.Fw.Lib" />
    <!-- Android-only Google Play in-app updates (used by Platforms/Android/AndroidInAppUpdateService.cs).
         Conditioned so it is not pulled into the Windows/iOS/Mac bundles, where it is unused. -->
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FwLiteMaui.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FwLiteShared\FwLiteShared.csproj" />
    <ProjectReference Include="..\LcmCrdt\LcmCrdt.csproj" />
    <ProjectReference Include="..\MiniLcm\MiniLcm.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(IncludeFwDataBridge)">
    <ProjectReference Include="..\FwDataMiniLcmBridge\FwDataMiniLcmBridge.csproj" />
    <ProjectReference Include="..\FwLiteProjectSync\FwLiteProjectSync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Only included so it can be excluded (from MiniLcm->SIL.WritingSystems)
      as it "does not have a 16 KB page size" (https://devblogs.microsoft.com/dotnet/maui-google-play-16-kb-page-size-support).
      It appears to have very minimal usage in SIL.LCMModel (setting execution bits and such), so excluding it is likely both safe and desirable.
      Excluding it in MiniLcm.csproj did not silence the build warnings.
    -->
    <PackageReference Include="Mono.Unix" ExcludeAssets="all" />
  </ItemGroup>
</Project>
