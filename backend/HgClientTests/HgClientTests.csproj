<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests a LexBox server with the hg client (MercurialVersion 3, 6 or 7) and the LibChorus and LfMergeBridge
       that FLEx Bridge shipped with it. Old LibChorus needs an older SIL.Core than LCModel, FwHeadless and LexBoxApi,
       so this project must only reference LexCore. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- To switch Mercurial versions (3, 6 or 7), set the MercurialVersion env var (or pass -p:) for both dotnet build and dotnet test -->
    <MercurialVersion Condition=" '$(MercurialVersion)' == '' ">7</MercurialVersion>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <!-- Old LibChorus gets the SIL.Core etc. it shipped with, not the backend's pinned versions -->
  <PropertyGroup Condition=" '$(MercurialVersion)' != '7' ">
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1605;NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <Choose>
    <!-- Next FLEx Bridge release -->
    <When Condition=" '$(MercurialVersion)' == '7' ">
      <ItemGroup>
        <PackageReference Include="SIL.ChorusPlugin.LfMergeBridge" />
        <PackageReference Include="SIL.Chorus.LibChorus" />
        <PackageReference Include="SIL.Chorus.Mercurial" />
      </ItemGroup>
    </When>
    <!-- FLEx Bridge 4.3 (Chorus 6.0.0-beta0063) -->
    <When Condition=" '$(MercurialVersion)' == '6' ">
      <ItemGroup>
        <PackageReference Include="SIL.ChorusPlugin.LfMergeBridge" VersionOverride="4.3.0-beta0048" />
        <PackageReference Include="SIL.Chorus.LibChorus" VersionOverride="6.0.0-beta0063" />
        <PackageReference Include="SIL.Chorus.Mercurial" VersionOverride="6.5.1.43" />
      </ItemGroup>
    </When>
    <!-- FLEx Bridge 4.1 (Chorus 5.2) -->
    <When Condition=" '$(MercurialVersion)' == '3' ">
      <ItemGroup>
        <PackageReference Include="SIL.ChorusPlugin.LfMergeBridge" VersionOverride="4.1.0" />
        <PackageReference Include="SIL.Chorus.LibChorus" VersionOverride="5.2.0-beta0005" />
        <PackageReference Include="SIL.Chorus.Mercurial" VersionOverride="3.0.3.11" />
      </ItemGroup>
    </When>
  </Choose>
  <Target Name="ValidateMercurialVersion" BeforeTargets="CollectPackageReferences;Build">
    <Error Condition=" '$(MercurialVersion)' != '3' And '$(MercurialVersion)' != '6' And '$(MercurialVersion)' != '7' "
           Text="MercurialVersion must be 3, 6 or 7, got '$(MercurialVersion)'" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="GitHubActionsTestLogger">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="XunitXml.TestLogger" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LexCore\LexCore.csproj" />
  </ItemGroup>
  <!-- Testing's API helpers, compiled here because Testing itself references LexBoxApi and LCModel -->
  <ItemGroup>
    <Compile Include="..\Testing\ApiTests\ApiTestBase.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Fixtures\AssertHttpResponse.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Fixtures\IntegrationFixture.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\LexCore\Utils\GqlUtils.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Services\Constants.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Services\HgRepoTestHelpers.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Services\JwtHelper.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Services\TestingEnvironmentVariables.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Testing\Services\Utils.cs" Link="Shared\%(Filename)%(Extension)" />
    <Content Include="..\Testing\test-template-repo.zip" Link="test-template-repo.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
  <!-- Stage Mercurial straight into the output, where Chorus looks for it -->
  <Target Name="StageMercurialInOutput" BeforeTargets="CopyFiles">
    <PropertyGroup>
      <Mercurial4ChorusDestDir>$(TargetDir)</Mercurial4ChorusDestDir>
    </PropertyGroup>
  </Target>
  <!-- FixFwData's dependencies (LCModel) clash with old LibChorus's, so it gets its own folder
       (not "FixFwData": on Linux that is its apphost's name) -->
  <ItemGroup>
    <ProjectReference Include="..\FixFwData\FixFwData.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFixFwData" AfterTargets="Build">
    <MSBuild Projects="..\FixFwData\FixFwData.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_FixFwDataTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_FixFwDataDir>@(_FixFwDataTargetPath->'%(RootDir)%(Directory)')</_FixFwDataDir>
    </PropertyGroup>
    <ItemGroup>
      <_FixFwDataFiles Include="$(_FixFwDataDir)**" />
    </ItemGroup>
    <Copy SourceFiles="@(_FixFwDataFiles)" DestinationFolder="$(TargetDir)FixFwDataTool\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- Older LfMergeBridge looks for FixFwData.exe on Linux too -->
    <Exec Condition=" '$(OS)' != 'Windows_NT' " Command="ln -f FixFwData FixFwData.exe" WorkingDirectory="$(TargetDir)FixFwDataTool" />
  </Target>
</Project>
