{
  "FwHeadlessConfig": {
    "LexboxUsername": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "SendReceive": "Information"
    }
  },
  "LcmCrdt": {
    // every commit names its author: SyncWorker stamps "FieldWorks", lexicon API writes stamp the Lexbox user
    "RequireCommitAuthor": true,
    "EnableProjectDataFileCache": false,
    // fail the sync job loudly instead of syncing on the snapshots from before an upgrade
    "ThrowOnModelVersionReconcileFailure": true
  },
  "AllowedHosts": "*",
  "OTEL_SERVICE_NAME": "fw-headless"
}
