      "runtimeArgs": ["-NoProfile", "-Command", "$env:FW_LITE_CHAOS='1.0'; dotnet run --project backend/FwLite/FwLiteWeb -- --FwLite:UpdateCheckCondition=Always"],
      "port": 5137
    }
  ]
