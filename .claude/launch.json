{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fw-lite-web",
      "runtimeExecutable": "task",
      "runtimeArgs": ["fw-lite-web"],
      "port": 5137
    },
    {
      "name": "viewer-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "frontend/viewer", "run", "dev"],
