{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "lexbox-dev": "vite dev --port 3000 --host 0.0.0.0",
    "prepare": "svelte-kit sync",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "playwright install chromium firefox",
    "test": "playwright test",
    "test-flaky": "playwright test --retries=3 -j 30%",
    "test-hard": "playwright test --repeat-each=3 -j 30%",
    "test-report": "playwright show-report test-results/_html-report",
    "_env-comment": "Run any command with .env.local loaded: (e.g. `pnpm run env run test -g 'test name')",
    "env": "dotenvx run --env-file=.env.local -- pnpm",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "lint": "svelte-kit sync && eslint . --cache",
    "lint:report": "svelte-kit sync && eslint-output",
    "format": "eslint . --fix",
    "clean": "pnpm dlx rimraf node_modules .svelte-kit"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@egoist/tailwindcss-icons": "^1.9.0",
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/client-preset": "^5.2.1",
    "@graphql-codegen/schema-ast": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "2.60.1",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-cookie": "^3.0.6",
    "@types/mjml": "^4.7.4",
    "@types/node": "^24.10.1",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/parser": "catalog:",
    "@urql/core": "^6.0.1",
    "@urql/devtools": "^2.0.3",
    "@urql/exchange-graphcache": "^8.1.0",
    "@urql/svelte": "^5.0.0",
    "@vitejs/plugin-basic-ssl": "catalog:",
    "autoprefixer": "catalog:",
    "css-tree": "^3.2.1",
    "daisyui": "^4.12.24",
    "e2e-mailbox": "1.1.5",
    "eslint": "catalog:",
    "eslint-output": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "^16.5.0",
    "graphql": "^16.12.0",
    "json5": "^2.2.3",
    "jwt-decode": "^4.0.0",
    "postcss": "catalog:",
    "rimraf": "^6.1.2",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "svelte-preprocess": "catalog:",
    "svelte-turnstile": "^0.11.0",
    "sveltekit-superforms": "^2.28.1",
    "tailwindcss": "catalog:",
    "tslib": "catalog:",
    "type-fest": "^5.8.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-graphql-codegen": "^3.7.0",
    "vitest": "catalog:",
    "zod": "^4.1.13",
    "zxcvbn": "^4.4.2"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/auto-instrumentations-web": "^0.66.0",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "estree-walker": "^3.0.3",
    "js-cookie": "^3.0.7",
    "just-order-by": "^1.0.0",
    "mjml": "^4.17.1",
    "runed": "catalog:",
    "set-cookie-parser": "^3.1.2",
    "svelte-exmarkdown": "catalog:",
    "svelte-intl-precompile": "^0.12.3",
    "tus-js-client": "^4.3.1"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.0",
      "@types/mjml-core": "^4.15.2",
      "minimatch@9": "^9.0.7",
      "immutable@3": "^3.8.3"
    }
  }
}
